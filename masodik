import React, { useRef, useEffect } from 'react';

export default function KaleidoscopeMeditation() {
  const canvasRef = useRef(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    let animationFrameId;

    const resizeCanvas = () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    };
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    const draw = (time) => {
      const t = time * 0.001; // time in seconds
      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const petals = 8;
      const radius = Math.min(w, h) * 0.4;

      // dark background for melatonin-friendly tone
      ctx.fillStyle = 'rgba(10, 5, 15, 0.9)';
      ctx.fillRect(0, 0, w, h);

      ctx.save();
      ctx.translate(cx, cy);
      const thetaSpeed = 0.1; // slow rotation speed
      const breathing = 0.2 * Math.sin(t * 2 * Math.PI * 0.25) + 1.0; // gentle pulsing ~4Hz
      const rotation = t * thetaSpeed;

      for (let i = 0; i < petals; i++) {
        ctx.save();
        ctx.rotate((Math.PI * 2 * i) / petals + rotation);

        const grad = ctx.createRadialGradient(0, 0, 0, 0, radius, radius * 1.2);
        grad.addColorStop(0, 'rgba(255, 200, 100, 0.9)');
        grad.addColorStop(0.5, 'rgba(255, 160, 60, 0.6)');
        grad.addColorStop(1, 'rgba(80, 40, 0, 0)');

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.ellipse(0, radius * 0.25 * breathing, radius * 0.6 * breathing, radius * 1.2, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }
      ctx.restore();

      animationFrameId = requestAnimationFrame(draw);
    };

    animationFrameId = requestAnimationFrame(draw);
    return () => {
      window.removeEventListener('resize', resizeCanvas);
      cancelAnimationFrame(animationFrameId);
    };
  }, []);

  return (
    <canvas ref={canvasRef} className="w-full h-full fixed top-0 left-0" />
  );
}
